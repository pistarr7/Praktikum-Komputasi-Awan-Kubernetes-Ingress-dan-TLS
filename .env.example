# ============================================================
# Cloud File Manager — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi kredensial asli.
# ============================================================

# Port aplikasi (default: 3000)
PORT=3000

# MinIO endpoint — nama service Kubernetes atau hostname
MINIO_ENDPOINT=minio-service

# MinIO API port (default: 9000)
MINIO_PORT=9000

# Gunakan SSL untuk koneksi MinIO? (default: false)
MINIO_USE_SSL=false

# Kredensial MinIO (WAJIB diisi, tidak ada default)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Nama bucket yang akan digunakan (default: tugas3)
MINIO_BUCKET=tugas3
